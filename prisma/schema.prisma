generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  DONOR
  ONG
  ADMIN
}

enum DonationStatus {
  AVAILABLE
  RESERVED
  COLLECTED
  EXPIRED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         Role
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  profile        Profile?
  donorDonations Donation[] @relation("DonorDonations")
  ongDonations   Donation[] @relation("OngDonations")
}

model Profile {
  id          String @id @default(uuid())
  userId      String @unique
  name        String
  document    String
  zipCode     String
  state       String
  profileType String

  user User @relation(fields: [userId], references: [id])
}

model Donation {
  id           String         @id @default(uuid())
  name         String
  category     String
  weightKg     Decimal
  expiresAt    DateTime
  status       DonationStatus @default(AVAILABLE)
  notes        String?
  moedasVerdes Decimal?
  token        String?
  donorId      String
  ongId        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  donor User  @relation("DonorDonations", fields: [donorId], references: [id])
  ong   User? @relation("OngDonations", fields: [ongId], references: [id])

  @@index([donorId, status])
  @@index([expiresAt])
}

model AuditLog {
  id          String   @id @default(uuid())
  donationId  String
  ongId       String
  donorId     String
  executorId  String
  timestamp   DateTime @default(now())

  @@index([donationId])
  @@index([timestamp])
  @@map("audit_logs")
}
