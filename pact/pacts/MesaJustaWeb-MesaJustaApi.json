{
  "consumer": {
    "name": "MesaJustaWeb"
  },
  "interactions": [
    {
      "description": "a request for available donations",
      "providerStates": [
        {
          "name": "existing donations"
        }
      ],
      "request": {
        "headers": {
          "Accept": "application/json"
        },
        "method": "GET",
        "path": "/api/v1/donations",
        "query": {
          "lat": [
            "-23.5"
          ],
          "lng": [
            "-46.6"
          ],
          "radius": [
            "15"
          ]
        }
      },
      "response": {
        "body": {
          "donations": [
            {
              "category": "Mercearia",
              "distanceKm": 3.2,
              "id": "uuid-123",
              "latitude": -23.5,
              "longitude": -46.6,
              "name": "Arroz",
              "weightKg": 10
            }
          ]
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.donations": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.donations[*].category": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.donations[*].distanceKm": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "number"
                }
              ]
            },
            "$.donations[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.donations[*].latitude": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "number"
                }
              ]
            },
            "$.donations[*].longitude": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "number"
                }
              ]
            },
            "$.donations[*].name": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.donations[*].weightKg": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "number"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a request without authentication",
      "providerStates": [
        {
          "name": "no auth token"
        }
      ],
      "request": {
        "headers": {
          "Accept": "application/json"
        },
        "method": "GET",
        "path": "/api/v1/donations"
      },
      "response": {
        "body": {
          "error": "Não autorizado."
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.error": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 401
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "16.5.0"
    },
    "pactRust": {
      "ffi": "0.5.4",
      "models": "1.3.11"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "MesaJustaApi"
  }
}